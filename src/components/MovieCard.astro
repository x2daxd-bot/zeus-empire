---
const { movie } = Astro.props; 

// 🟢 الذكاء البرمجي: التحقق هل هذا المحتوى فيلم أم مسلسل؟
const isTV = movie.media_type === 'tv' || (movie.name && !movie.title);
const linkPath = isTV ? `/tv/${movie.id}` : `/movie/${movie.id}`;

// استخراج السنة فقط بشكل آمن
const releaseDate = movie.release_date || movie.first_air_date;
const releaseYear = releaseDate ? releaseDate.split('-')[0] : 'قريباً';

// تنسيق التقييم
const rating = movie.vote_average ? movie.vote_average.toFixed(1) : null;
---

<a href={linkPath} class="movie-link">
    <div class="movie-card">
        {rating && rating > 0 && (
            <div class="rating-tag">
                <span class="star">⭐</span>
                <span class="score">{rating}</span>
            </div>
        )}
        
        <div class="poster-wrapper">
            <img 
                src={movie.poster_path ? `https://image.tmdb.org/t/p/w500${movie.poster_path}` : '/placeholder-poster.jpg'} 
                alt={movie.title || movie.name} 
                loading="lazy" 
            />
            <div class="play-overlay">
                <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                    <path d="M8 5.14V19.14L19 12.14L8 5.14Z" />
                </svg>
            </div>
        </div>
        
        <div class="card-info">
            <h3>{movie.title || movie.name}</h3>
            <div class="meta-data">
                <span class="type-badge">{isTV ? 'مسلسل' : 'فيلم'}</span>
                <span class="dot">•</span>
                <span class="year">{releaseYear}</span>
            </div>
        </div>
    </div>
</a>

<style>
    /* الرابط الأساسي */
    .movie-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

    /* حاوية الكارت الأساسية */
    .movie-card {
        position: relative;
        background: #111;
        border-radius: 16px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.5s cubic-bezier(0.23, 1, 0.32, 1);
        border: 1px solid rgba(255, 255, 255, 0.05);
        height: 100%;
    }

    /* تأثيرات الـ Hover */
    .movie-card:hover { 
        transform: translateY(-12px) scale(1.02); 
        border-color: var(--primary, #ff0055);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6), 0 0 20px var(--primary-glow, rgba(255, 0, 85, 0.2));
    }

    /* غلاف الصورة */
    .poster-wrapper {
        position: relative;
        aspect-ratio: 2/3;
        overflow: hidden;
    }

    img { 
        width: 100%; 
        height: 100%;
        object-fit: cover; 
        transition: transform 0.6s ease, filter 0.4s ease;
    }

    .movie-card:hover img {
        transform: scale(1.1);
        filter: brightness(0.3) blur(2px);
    }

    /* أيقونة التشغيل */
    .play-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0.8);
        width: 60px;
        height: 60px;
        background: var(--primary, #ff0055);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        color: white;
        box-shadow: 0 0 30px var(--primary-glow);
    }

    .play-overlay svg { width: 30px; height: 30px; margin-right: -3px; }

    .movie-card:hover .play-overlay {
        opacity: 1;
        transform: translate(-50%, -50%) scale(1);
    }

    /* ملصق التقييم الزجاجي */
    .rating-tag {
        position: absolute; 
        top: 12px; 
        right: 12px;
        background: rgba(0, 0, 0, 0.6); 
        backdrop-filter: blur(10px);
        padding: 5px 10px;
        border-radius: 10px; 
        z-index: 10;
        border: 1px solid rgba(255, 255, 255, 0.1);
        display: flex;
        align-items: center;
        gap: 5px;
    }
    .score { color: #ffc107; font-weight: 800; font-size: 0.85rem; }

    /* منطقة المعلومات */
    .card-info { 
        padding: 15px;
        background: linear-gradient(to top, #111 80%, transparent);
    }

    h3 { 
        font-size: 0.95rem; 
        margin: 0; 
        color: white; 
        white-space: nowrap; 
        overflow: hidden; 
        text-overflow: ellipsis; 
        font-weight: 700;
        transition: 0.3s;
    }

    .movie-card:hover h3 { color: var(--primary); }

    .meta-data { 
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 6px;
        color: #888;
        font-size: 0.8rem;
    }

    .type-badge {
        color: var(--primary);
        font-weight: 600;
    }

    .dot { font-size: 1.2rem; line-height: 0; color: #333; }
</style>