---
export const prerender = false;

import Navbar from '../../components/Navbar.astro';
import '../../styles/global.css';

const { id } = Astro.params;
const API_KEY = import.meta.env.TMDB_API_KEY;

let movie;
let credits;

try {
    // جلب بيانات الفيلم وطاقم العمل في آن واحد
    const [movieRes, creditsRes] = await Promise.all([
        fetch(`https://api.themoviedb.org/3/movie/${id}?api_key=${API_KEY}&language=ar`),
        fetch(`https://api.themoviedb.org/3/movie/${id}/credits?api_key=${API_KEY}&language=ar`)
    ]);

    movie = await movieRes.json();
    credits = await creditsRes.json();
} catch (e) {
    console.error("Fetch error:", e);
}

// حماية في حال فشل الجلب أو الفيلم غير موجود
if (!movie || movie.success === false) return Astro.redirect('/404');

const videoSrc = `https://vidsrc.to/embed/movie/${id}`;
const backdrop = movie.backdrop_path 
    ? `https://image.tmdb.org/t/p/original${movie.backdrop_path}` 
    : '/fallback-backdrop.jpg';
---

<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <title>{movie.title} - ZEUS</title>
</head>
<body>
    <Navbar />
    
    <div class="movie-backdrop" style={`background-image: url(${backdrop})`}></div>

    <main class="movie-page">
        <div class="container">
            
            <section class="hero-section">
                <div class="poster-container">
                    <img src={`https://image.tmdb.org/t/p/w500${movie.poster_path}`} class="main-poster" alt={movie.title} />
                </div>
                
                <div class="info-content">
                    <h1>{movie.title}</h1>
                    {movie.tagline && <p class="tagline">"{movie.tagline}"</p>}
                    
                    <div class="meta-row">
                        <span class="badge">📅 {movie.release_date?.split('-')[0]}</span>
                        <span class="badge">⏱️ {movie.runtime} دقيقة</span>
                        <span class="badge rating">⭐ {movie.vote_average?.toFixed(1)}</span>
                    </div>

                    <div class="actions">
                        <button id="favBtn" class="btn-action" data-id={id} data-title={movie.title} data-poster={movie.poster_path}>
                            <span class="icon">❤</span>
                            <span class="text">إضافة للمفضلة</span>
                        </button>
                        
                        <button id="shareBtn" class="btn-action">
                            <span>🔗</span> مشاركة
                        </button>
                    </div>

                    <p class="overview">{movie.overview || "لا يوجد وصف متاح للفيلم حالياً."}</p>

                    <div class="cast-wrapper">
                        <h3>طاقم العمل</h3>
                        <div class="cast-grid">
                            {credits?.cast?.slice(0, 5).map((actor) => (
                                <div class="actor-card">
                                    <img src={actor.profile_path ? `https://image.tmdb.org/t/p/w185${actor.profile_path}` : '/no-avatar.png'} alt={actor.name} />
                                    <span>{actor.name}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </section>

            <section class="watch-section glass-effect">
                <div class="section-header">
                    <div class="live-dot"></div>
                    <h2>سيرفر المشاهدة الرئيسي</h2>
                </div>
                <div class="player-container">
                    <iframe src={videoSrc} allowfullscreen frameborder="0"></iframe>
                </div>
                <div class="player-footer">
                    <p>إذا واجهت مشكلة في التشغيل، حاول تحديث الصفحة أو استخدام VPN.</p>
                </div>
            </section>

        </div>
    </main>

    <style>
        .movie-backdrop {
            position: fixed; top: 0; left: 0; width: 100%; height: 100vh;
            background-size: cover; background-position: center;
            z-index: -1; filter: brightness(0.2) blur(8px);
        }
        .movie-page { padding-top: 100px; color: white; min-height: 100vh; }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }

        .hero-section { display: grid; grid-template-columns: 320px 1fr; gap: 50px; margin-bottom: 60px; }
        .main-poster { width: 100%; border-radius: 20px; box-shadow: 0 20px 50px rgba(0,0,0,0.8); border: 1px solid rgba(255,255,255,0.1); }

        .info-content h1 { font-size: 3.5rem; margin-bottom: 10px; font-weight: 800; }
        .tagline { color: var(--primary); font-size: 1.3rem; margin-bottom: 25px; opacity: 0.9; }
        
        .meta-row { display: flex; gap: 15px; margin-bottom: 30px; }
        .badge { background: rgba(255,255,255,0.1); padding: 8px 18px; border-radius: 12px; font-size: 0.95rem; border: 1px solid rgba(255,255,255,0.05); }
        .rating { color: gold; border-color: rgba(255, 215, 0, 0.2); }

        .actions { display: flex; gap: 15px; margin-bottom: 35px; }
        .btn-action { background: rgba(255,255,255,0.08); border: 1px solid #333; color: white; padding: 12px 25px; border-radius: 50px; cursor: pointer; transition: 0.3s; display: flex; align-items: center; gap: 10px; font-weight: bold; }
        .btn-action:hover { background: var(--primary); border-color: var(--primary); transform: translateY(-3px); }
        .is-favorite { background: var(--primary); border-color: var(--primary); box-shadow: 0 0 20px var(--primary-glow); }

        .overview { font-size: 1.15rem; line-height: 1.9; color: #eee; margin-bottom: 40px; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }

        /* طاقم العمل */
        .cast-wrapper h3 { margin-bottom: 20px; font-size: 1.5rem; }
        .cast-grid { display: flex; gap: 20px; overflow-x: auto; padding-bottom: 15px; }
        .actor-card { width: 100px; flex-shrink: 0; text-align: center; }
        .actor-card img { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; margin-bottom: 10px; border: 2px solid rgba(255,255,255,0.1); }
        .actor-card span { font-size: 0.8rem; color: #bbb; display: block; }

        /* قسم الفيديو */
        .watch-section { padding: 40px; border-radius: 30px; margin-bottom: 100px; }
        .section-header { display: flex; align-items: center; gap: 15px; margin-bottom: 25px; }
        .live-dot { width: 12px; height: 12px; background: #ff0000; border-radius: 50%; box-shadow: 0 0 15px #ff0000; animation: blink 1.5s infinite; }
        @keyframes blink { 0% { opacity: 1; } 50% { opacity: 0.3; } 100% { opacity: 1; } }

        .player-container { position: relative; padding-bottom: 56.25%; height: 0; border-radius: 20px; overflow: hidden; border: 1px solid #222; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
        .player-container iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
        .player-footer { margin-top: 20px; text-align: center; color: #666; font-size: 0.9rem; }

        @media (max-width: 900px) {
            .hero-section { grid-template-columns: 1fr; text-align: center; }
            .poster-container { display: none; }
            .meta-row, .actions { justify-content: center; }
            .info-content h1 { font-size: 2.5rem; }
        }
    </style>

    <script>
        import { db, auth } from '../../lib/firebase';
        import { doc, setDoc, deleteDoc, getDoc } from "firebase/firestore";

        const favBtn = document.getElementById('favBtn');
        const movieId = favBtn?.dataset.id;

        // 1. نظام المفضلة (Firestore)
        auth.onAuthStateChanged(async (user) => {
            if (user && movieId) {
                const docRef = doc(db, "users", user.uid, "favorites", movieId);
                const docSnap = await getDoc(docRef);
                if (docSnap.exists()) {
                    favBtn.classList.add('is-favorite');
                    favBtn.querySelector('.text').innerText = "في المفضلة";
                }
            }
        });

        favBtn?.addEventListener('click', async () => {
            const user = auth.currentUser;
            if (!user) return alert("سجل دخولك أولاً!");

            const docRef = doc(db, "users", user.uid, "favorites", movieId);
            if (favBtn.classList.contains('is-favorite')) {
                await deleteDoc(docRef);
                favBtn.classList.remove('is-favorite');
                favBtn.querySelector('.text').innerText = "إضافة للمفضلة";
            } else {
                await setDoc(docRef, {
                    id: movieId,
                    title: favBtn.dataset.title,
                    poster: favBtn.dataset.poster,
                    type: 'movie',
                    addedAt: new Date()
                });
                favBtn.classList.add('is-favorite');
                favBtn.querySelector('.text').innerText = "في المفضلة";
            }
        });

        // 2. زر المشاركة
        document.getElementById('shareBtn')?.addEventListener('click', () => {
            if (navigator.share) {
                navigator.share({ title: document.title, url: window.location.href });
            } else {
                navigator.clipboard.writeText(window.location.href);
                alert("تم نسخ رابط الفيلم!");
            }
        });
    </script>
</body>
</html>