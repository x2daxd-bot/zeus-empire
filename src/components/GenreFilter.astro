---
// 1. جلب التصنيفات من API (تنفذ عند بناء الموقع)
const API_KEY = import.meta.env.TMDB_API_KEY || 'ضع_مفتاحك_هنا_إذا_لم_يعمل_المتغير';
const response = await fetch(`https://api.themoviedb.org/3/genre/movie/list?api_key=${API_KEY}&language=ar`);
const data = await response.json();
const genres = data.genres || [];
---

<div class="genre-container reveal">
    <div class="genre-scroll" id="genreScroll">
        <button class="genre-btn active" data-id="all">الكل</button>
        {genres.map((genre) => (
            <button class="genre-btn" data-id={genre.id}>
                {genre.name}
            </button>
        ))}
    </div>
</div>

<style>
    .genre-container {
        padding: 20px 5%;
        margin-top: 10px;
        z-index: 10;
    }

    .genre-scroll {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        padding: 10px 5px;
        scrollbar-width: none;
    }

    .genre-scroll::-webkit-scrollbar { display: none; }

    .genre-btn {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: white;
        padding: 10px 25px;
        border-radius: 50px;
        white-space: nowrap;
        cursor: pointer;
        transition: all 0.3s ease;
        font-weight: 600;
        font-family: 'Cairo', sans-serif;
    }

    .genre-btn:hover {
        background: rgba(255, 0, 85, 0.2);
        border-color: var(--primary);
    }

    .genre-btn.active {
        background: var(--primary);
        color: white;
        box-shadow: 0 0 15px var(--primary-glow);
        border-color: var(--primary);
    }
</style>

<script>
    // هذا الجزء يعمل في المتصفح (Client-side) ليكون تفاعلياً
    const API_KEY = '9ba1324328f41334f8664188448f2d5a'; // تأكد من مطابقة المفتاح
    const genreButtons = document.querySelectorAll('.genre-btn');
    const trendingGrid = document.getElementById('trendingGrid');

    genreButtons.forEach(btn => {
        btn.addEventListener('click', async () => {
            // 1. تغيير التصميم للزر المختار
            document.querySelector('.genre-btn.active')?.classList.remove('active');
            btn.classList.add('active');

            const genreId = btn.getAttribute('data-id');
            
            // 2. إظهار حالة التحميل (Skeleton)
            if (trendingGrid) {
                trendingGrid.style.opacity = '0.5';
            }

            try {
                // 3. بناء الرابط بناءً على النوع المختار
                let url = `https://api.themoviedb.org/3/trending/all/week?api_key=${API_KEY}&language=ar`;
                if (genreId !== 'all') {
                    url = `https://api.themoviedb.org/3/discover/movie?api_key=${API_KEY}&with_genres=${genreId}&language=ar&sort_by=popularity.desc`;
                }

                const res = await fetch(url);
                const data = await res.json();
                
                // 4. تحديث الواجهة بالنتائج الجديدة
                updateMovieGrid(data.results);
            } catch (error) {
                console.error("خطأ في جلب البيانات:", error);
            } finally {
                if (trendingGrid) trendingGrid.style.opacity = '1';
            }
        });
    });

    // وظيفة لرسم الأفلام الجديدة داخل التخطيط
    function updateMovieGrid(movies) {
        if (!trendingGrid) return;

        trendingGrid.innerHTML = movies.map(movie => {
            const title = movie.title || movie.name;
            const isTV = movie.media_type === 'tv' || !movie.title;
            const rating = movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A';
            const year = (movie.release_date || movie.first_air_date || '').split('-')[0];
            const link = isTV ? `/tv/${movie.id}` : `/movie/${movie.id}`;

            return `
                <a href="${link}" class="movie-link reveal">
                    <div class="movie-card" style="background: #111; border-radius: 15px; overflow: hidden; position: relative; transition: 0.3s;">
                        <div class="rating-tag" style="position: absolute; top: 10px; right: 10px; background: rgba(0,0,0,0.7); padding: 5px 10px; border-radius: 8px; color: #ffc107; z-index: 2; font-size: 0.8rem;">
                            ⭐ ${rating}
                        </div>
                        <div class="poster-wrapper" style="aspect-ratio: 2/3; overflow: hidden;">
                            <img src="https://image.tmdb.org/t/p/w500${movie.poster_path}" alt="${title}" style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>
                        <div class="card-info" style="padding: 15px; background: linear-gradient(to top, #000, transparent);">
                            <h3 style="font-size: 0.9rem; margin: 0; color: white; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${title}</h3>
                            <p style="color: #888; font-size: 0.8rem; margin: 5px 0 0;">${isTV ? 'مسلسل' : 'فيلم'} • ${year}</p>
                        </div>
                    </div>
                </a>
            `;
        }).join('');
    }
</script>