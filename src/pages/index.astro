---
// 1. منطقة الـ Frontmatter (تنفذ على السيرفر)
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import MovieCard from '../components/MovieCard.astro';
import AuthModal from '../components/AuthModal.astro';
import GenreFilter from '../components/GenreFilter.astro';
import Footer from '../components/Footer.astro';

const API_KEY = import.meta.env.TMDB_API_KEY;

// جلب بيانات الأفلام والمسلسلات الرائجة
const response = await fetch(`https://api.themoviedb.org/3/trending/all/week?api_key=${API_KEY}&language=ar`);
const data = await response.json();
const trendingItems = data.results || [];
const heroMovie = trendingItems[0]; // الفيلم الأول للواجهة
---

<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZEUS EMPIRE - عالم الترفيه الاحترافي</title>
</head>
<body>
    <div id="splashScreen">
        <img src="https://i.ibb.co/689NfR6/zeus-logo.png" alt="ZEUS Logo" class="splash-logo">
        <div class="loader"></div>
        <h1 class="splash-title">ZEUS EMPIRE</h1>
    </div>

    <AuthModal />
    <Navbar />

    <main>
        <section id="heroSection" class="hero-premium" style={`background-image: linear-gradient(to right, #000 20%, transparent 60%), linear-gradient(to top, #080808 10%, transparent 40%), url(https://image.tmdb.org/t/p/original${heroMovie?.backdrop_path})`}>
            <div class="hero-content">
                <span class="trending-badge">🔥 يتصدر المشاهدات الآن</span>
                <h1>{heroMovie?.title || heroMovie?.name}</h1>
                <p>{heroMovie?.overview?.substring(0, 180)}...</p>
                <div class="hero-btns">
                    <a href={heroMovie?.media_type === 'tv' ? `/tv/${heroMovie?.id}` : `/movie/${heroMovie?.id}`} class="btn-main">
                        <span>▶</span> مشاهدة الآن
                    </a>
                    <button class="btn-outline" id="heroFavBtn">+ المفضلة</button>
                </div>
            </div>
        </section>

        <section id="searchResultsSection" class="container hidden">
            <h2 class="section-title">نتائج البحث</h2>
            <div id="searchResultsGrid" class="movies-grid"></div>
        </section>

        <div id="genreWrapper">
            <GenreFilter />
        </div>

        <section id="trendingSection" class="container">
            <h2 class="section-title">الأفلام والمسلسلات الرائجة</h2>
            <div class="movies-grid">
                {trendingItems.map((item) => (
                    <div class="reveal">
                        <MovieCard movie={item} />
                    </div>
                ))}
            </div>
        </section>
    </main>

    <Footer />

    <style>
        /* المتغيرات الجمالية */
        :root {
            --primary: #ff0055;
            --primary-glow: rgba(255, 0, 85, 0.4);
            --bg-dark: #080808;
        }

        body {
            background-color: var(--bg-dark);
            overflow-x: hidden;
        }

        /* تأثير الشبكة المتحركة للخلفية */
        body::before {
            content: "";
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: 
                radial-gradient(circle at 10% 20%, rgba(255, 0, 85, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 90% 80%, rgba(0, 225, 255, 0.05) 0%, transparent 40%);
            z-index: -1;
            pointer-events: none;
        }

        .container { padding: 40px 5%; }

        /* تنسيق الـ Hero الاحترافي */
        .hero-premium {
            height: 85vh;
            display: flex;
            align-items: center;
            background-size: cover;
            background-position: center 20%;
            position: relative;
            padding: 0 5%;
            margin-top: -80px; /* تداخل مع النافبار الشفاف */
        }

        .hero-content { 
            max-width: 700px; 
            z-index: 2; 
            animation: fadeInUp 1s ease-out;
        }
        
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .hero-content h1 { 
            font-size: clamp(2rem, 5vw, 4rem); 
            margin: 20px 0; 
            font-weight: 800;
            text-shadow: 0 5px 15px rgba(0,0,0,0.5);
            line-height: 1.1;
        }

        .hero-content p { 
            font-size: 1.1rem; 
            color: #ddd; 
            line-height: 1.8; 
            margin-bottom: 35px;
            text-shadow: 1px 1px 5px rgba(0,0,0,0.5);
        }

        .trending-badge {
            background: var(--primary);
            color: white;
            padding: 6px 16px;
            border-radius: 50px;
            font-size: 0.85rem;
            font-weight: 600;
            box-shadow: 0 0 15px var(--primary-glow);
        }

        .hero-btns { display: flex; gap: 15px; }
        
        .btn-main { 
            background: var(--primary); 
            color: white; 
            padding: 14px 35px; 
            border-radius: 12px; 
            text-decoration: none; 
            font-weight: bold;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        
        .btn-main:hover { 
            transform: scale(1.05) translateY(-3px); 
            box-shadow: 0 10px 20px var(--primary-glow);
        }

        .btn-outline { 
            background: rgba(255,255,255,0.05); 
            color: white; 
            border: 1px solid rgba(255,255,255,0.2);
            padding: 14px 35px; 
            border-radius: 12px; 
            cursor: pointer; 
            backdrop-filter: blur(10px);
            transition: 0.3s;
        }
        .btn-outline:hover { background: rgba(255,255,255,0.15); border-color: white; }

        .section-title {
            margin-bottom: 40px;
            font-size: 2rem;
            border-right: 6px solid var(--primary);
            padding-right: 20px;
            color: white;
            font-weight: 700;
        }

        .movies-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 30px;
        }

        /* أنيميشن الظهور عند التمرير */
        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.8s cubic-bezier(0.23, 1, 0.32, 1);
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        .hidden { display: none !important; }

        /* ستايل الشاشة الافتتاحية */
        #splashScreen {
            position: fixed; inset: 0; background: #000; z-index: 10000;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
        }
        .splash-logo { width: 180px; filter: drop-shadow(0 0 25px var(--primary)); animation: pulse 2s infinite; }
        .splash-title { color: white; margin-top: 20px; letter-spacing: 5px; font-size: 1.5rem; }
        
        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.9; }
            50% { transform: scale(1.1); opacity: 1; }
        }

        /* تحسين شريط التمرير */
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: #080808; }
        ::-webkit-scrollbar-thumb { background: #222; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--primary); }
    </style>

    <script define:vars={{ apiKey: API_KEY }}>
        // 1. منطق الشاشة الافتتاحية (Splash)
        window.addEventListener('load', () => {
            setTimeout(() => {
                const splash = document.getElementById('splashScreen');
                if (splash) {
                    splash.style.opacity = '0';
                    splash.style.transition = 'opacity 0.8s ease';
                    setTimeout(() => splash.remove(), 800);
                }
            }, 1200);
        });

        // 2. منطق كشف العناصر عند التمرير (Scroll Reveal)
        const revealElements = () => {
            const reveals = document.querySelectorAll(".reveal");
            reveals.forEach(el => {
                const windowHeight = window.innerHeight;
                const elementTop = el.getBoundingClientRect().top;
                if (elementTop < windowHeight - 100) {
                    el.classList.add("active");
                }
            });
        };
        window.addEventListener("scroll", revealElements);
        window.addEventListener("load", revealElements);

        // 3. البحث الحي الفائق
        const searchInput = document.getElementById('searchInput');
        const searchResultsSection = document.getElementById('searchResultsSection');
        const searchResultsGrid = document.getElementById('searchResultsGrid');
        const mainSections = [
            document.getElementById('heroSection'),
            document.getElementById('trendingSection'),
            document.getElementById('genreWrapper')
        ];

        let searchDebounce;

        searchInput?.addEventListener('input', (e) => {
            clearTimeout(searchDebounce);
            const query = e.target.value.trim();

            if (query.length < 3) {
                searchResultsSection.classList.add('hidden');
                mainSections.forEach(s => s?.classList.remove('hidden'));
                return;
            }

            searchDebounce = setTimeout(async () => {
                const res = await fetch(`https://api.themoviedb.org/3/search/multi?api_key=${apiKey}&query=${encodeURIComponent(query)}&language=ar`);
                const data = await res.json();
                
                if (data.results) {
                    mainSections.forEach(s => s?.classList.add('hidden'));
                    searchResultsSection.classList.remove('hidden');
                    renderSearchResults(data.results);
                }
            }, 500);
        });

        function renderSearchResults(results) {
            searchResultsGrid.innerHTML = results
                .filter(item => item.poster_path)
                .map(item => {
                    const isTV = item.media_type === 'tv' || item.name;
                    const link = isTV ? `/tv/${item.id}` : `/movie/${item.id}`;
                    return `
                        <a href="${link}" class="movie-link">
                            <div class="movie-card-mini" style="background:#111; border-radius:12px; overflow:hidden; border:1px solid #222;">
                                <img src="https://image.tmdb.org/t/p/w500${item.poster_path}" style="width:100%; aspect-ratio:2/3; object-fit:cover;" />
                                <div style="padding:10px;">
                                    <h3 style="font-size:0.85rem; color:white; margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${item.title || item.name}</h3>
                                </div>
                            </div>
                        </a>
                    `;
                }).join('');
        }
    </script>
</body>
</html>