---
// هنا منطقة السيرفر: لا نحتاج منطقاً خاصاً حالياً
---

<div id="authModal" class="modal hidden">
    <div class="modal-content glass-effect">
        <button id="closeAuth" class="close-btn">✖</button>
        
        <div class="auth-tabs">
            <button id="tabLogin" class="active">تسجيل دخول</button>
            <button id="tabSignup">حساب جديد</button>
        </div>

        <form id="authForm">
            <input type="email" id="authEmail" placeholder="البريد الإلكتروني" required />
            <input type="password" id="authPassword" placeholder="كلمة المرور" required />
            <button type="submit" id="authSubmitBtn">دخول</button>
        </form>
        
        <p id="authError" class="error-msg"></p>
    </div>
</div>

<style>
    .modal {
        position: fixed; inset: 0; background: rgba(0,0,0,0.9);
        display: flex; align-items: center; justify-content: center;
        z-index: 10000; backdrop-filter: blur(10px);
    }
    .modal-content {
        background: #141414; padding: 40px; border-radius: 20px;
        width: 90%; max-width: 400px; border: 1px solid #333;
        position: relative;
    }
    .close-btn {
        position: absolute; top: 15px; left: 15px; background: none;
        border: none; color: white; cursor: pointer; font-size: 1.2rem;
    }
    .auth-tabs { display: flex; gap: 20px; margin-bottom: 25px; border-bottom: 1px solid #333; }
    .auth-tabs button { 
        background: none; border: none; color: #888; 
        cursor: pointer; font-size: 1.1rem; padding-bottom: 10px; flex: 1;
    }
    .auth-tabs button.active { 
        color: #ff0055; 
        border-bottom: 2px solid #ff0055; 
    }
    
    form { display: flex; flex-direction: column; gap: 15px; }
    input { 
        background: #222; border: 1px solid #444; padding: 14px; 
        border-radius: 8px; color: white; outline: none; font-size: 1rem;
    }
    input:focus { border-color: #ff0055; }
    #authSubmitBtn { 
        background: #ff0055; color: white; border: none; 
        padding: 14px; border-radius: 8px; cursor: pointer; 
        font-weight: bold; font-size: 1.1rem; margin-top: 10px;
    }
    .error-msg { color: #ff4444; font-size: 0.9rem; margin-top: 15px; text-align: center; min-height: 20px; }
    .hidden { display: none !important; }
</style>

<script>
    import { auth } from '../lib/firebase';
    import { 
        signInWithEmailAndPassword, 
        createUserWithEmailAndPassword, 
        onAuthStateChanged 
    } from "firebase/auth";

    const modal = document.getElementById('authModal');
    const authForm = document.getElementById('authForm');
    const emailInput = document.getElementById('authEmail');
    const passwordInput = document.getElementById('authPassword');
    const submitBtn = document.getElementById('authSubmitBtn');
    const authError = document.getElementById('authError');
    const tabLogin = document.getElementById('tabLogin');
    const tabSignup = document.getElementById('tabSignup');

    let isLoginMode = true; // الحالة الافتراضية

    // تبديل الواجهة بين دخول وتسجيل
    tabSignup.onclick = () => {
        isLoginMode = false;
        submitBtn.innerText = "إنشاء حساب جديد";
        tabSignup.classList.add('active');
        tabLogin.classList.remove('active');
    };

    tabLogin.onclick = () => {
        isLoginMode = true;
        submitBtn.innerText = "دخول";
        tabLogin.classList.add('active');
        tabSignup.classList.remove('active');
    };

    // تنفيذ العملية (دخول أو تسجيل)
    authForm.onsubmit = async (e) => {
        e.preventDefault();
        const email = emailInput.value;
        const password = passwordInput.value;
        authError.innerText = "جاري المعالجة...";

        try {
            if (isLoginMode) {
                await signInWithEmailAndPassword(auth, email, password);
            } else {
                await createUserWithEmailAndPassword(auth, email, password);
            }
            window.location.reload(); // تحديث الموقع بعد النجاح
        } catch (error) {
            authError.innerText = "خطأ: " + error.message;
        }
    };
</script>